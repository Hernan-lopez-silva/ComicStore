# Configuración de ambiente para los tests de Selenium

# URL de la aplicación
APP_URL=http://localhost:8000

# Credenciales de usuario existente (para tests de login)
TEST_USER_EMAIL=usuario.existente@comicstore.cl
TEST_USER_PASSWORD=SeguraPass123!

# Credenciales de administrador (para tests de admin)
TEST_ADMIN_EMAIL=admin@comicstore.cl
TEST_ADMIN_PASSWORD=AdminPass123!

# Configuración del navegador
BROWSER_HEADLESS=false
BROWSER_TIMEOUT=10

# Logging
LOG_LEVEL=INFO
CAPTURE_SCREENSHOTS=true
SCREENSHOT_PATH=./screenshots

# Ambiente
ENVIRONMENT=testing
DEBUG=false
